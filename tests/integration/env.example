# ============================================================
# Integration Test Environment — Template
# ============================================================
# Copy this file to tests/integration/.env and fill in the
# values printed by: supabase status
#
#   cp tests/integration/env.example tests/integration/.env
#
# IMPORTANT:
#   • tests/integration/.env is gitignored — NEVER commit it.
#   • These point at LOCAL Supabase (supabase start), NOT production.
#   • Run 'supabase start' before running integration tests.
#   • Run 'supabase status' to get the anon key + service role key.
# ============================================================

# Local Supabase API URL (always this value for supabase CLI local dev)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# From 'supabase status' → anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste anon key from supabase status>

# From 'supabase status' → service_role key
SUPABASE_SERVICE_ROLE_KEY=<paste service_role key from supabase status>

# Direct Postgres connection for withTx() savepoint helper
# (Supabase CLI default: host=127.0.0.1, port=54322, db=postgres, user=postgres, pass=postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
