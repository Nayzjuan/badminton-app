---
import BaseLayout from '../layouts/BaseLayout.astro';
import SandboxRoot from '@bbmt/digital-twin';
---

<BaseLayout
  title="Badminton Queue App"
  description="Automate your badminton queue. Smart matchmaking, real-time scoreboards, fair-play caps. No more whiteboards."
>

  <!-- ═══════════════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[88vh] flex flex-col justify-center px-6 pt-16 pb-20 overflow-hidden">

    <!-- Background grid pattern -->
    <div aria-hidden="true"
         class="pointer-events-none absolute inset-0 opacity-[0.04]"
         style="background-image: linear-gradient(oklch(96% 0.005 245) 1px, transparent 1px), linear-gradient(90deg, oklch(96% 0.005 245) 1px, transparent 1px); background-size: 40px 40px;">
    </div>

    <div class="relative mx-auto w-full max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 items-center">

        <!-- Left: headline + CTAs -->
        <div class="max-w-2xl">
          <h1 class="font-heading font-bold leading-[0.95] tracking-tight text-ink mb-6"
              style="font-size: clamp(3rem, 8vw, 6rem);">
            Automate Your<br/>
            <span class="text-accent">Badminton Queue.</span>
          </h1>

          <p class="text-ink-3 leading-relaxed mb-8 max-w-lg"
             style="font-size: clamp(1rem, 2vw, 1.2rem);">
            No more whiteboards. No more empty courts. No more "whose turn is it?"
            Smart matchmaking keeps every court busy and every player happy.
          </p>

          <div class="flex flex-wrap gap-3">
            <a href="#sandbox"
               class="inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3 font-heading font-bold text-base transition-colors duration-75 hover:bg-accent-hi"
               style="color: var(--color-base)">
              Try the Demo
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <!-- Right: stat block -->
        <aside class="hidden lg:flex flex-col gap-4 shrink-0">
          {[
            { value: '0',  unit: 'empty courts',   sub: 'engine fills every slot' },
            { value: '∞',  unit: 'fair rotations',  sub: 'no-repeat partnership cap' },
            { value: '1',  unit: 'tap to score',    sub: 'real-time for all players' },
          ].map(s => (
            <div class="rounded-2xl border border-edge-hi bg-overlay px-6 py-4 w-52">
              <div class="font-heading font-bold text-accent-hi leading-none mb-1"
                   style="font-size: 2.75rem;">{s.value}</div>
              <div class="text-sm font-semibold text-ink-2 leading-snug">{s.unit}</div>
              <div class="text-[11px] text-ink-4 mt-0.5">{s.sub}</div>
            </div>
          ))}
        </aside>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       FEATURES — asymmetric grid, not a standard 3-icon card layout
  ══════════════════════════════════════════════════════════════════ -->
  <section id="features" data-reveal-section class="px-6 py-20 border-t border-edge-dim scroll-mt-14">
    <div class="mx-auto max-w-6xl">

      <div class="feature-card mb-12" style="--i: 0">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent mb-3">What it does</p>
        <h2 class="font-heading font-bold text-ink leading-tight"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          Built for how real<br/>badminton clubs work.
        </h2>
      </div>

      <!-- Feature layout: 1 large + 2 stacked right -->
      <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-4">

        <!-- Feature 01 — large primary -->
        <div class="feature-card feature-lift-lg relative group rounded-2xl border overflow-hidden p-8 flex flex-col justify-between min-h-64"
             style="--i: 1; border-color: oklch(76% 0.17 155 / 0.22); background: linear-gradient(135deg, oklch(14% 0.065 155 / 0.7) 0%, var(--color-overlay) 55%);">

          <!-- Subtle court grid overlay -->
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.03]"
               style="background-image: linear-gradient(oklch(76% 0.17 155) 1px, transparent 1px), linear-gradient(90deg, oklch(76% 0.17 155) 1px, transparent 1px); background-size: 28px 28px;"></div>

          <!-- Hover border glow (inset shadow) -->
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"
               style="box-shadow: inset 0 0 0 1px oklch(76% 0.17 155 / 0.5);"></div>

          <div class="relative flex items-start justify-between">
            <div class="font-heading font-bold text-[5rem] leading-none select-none"
                 style="color: oklch(76% 0.17 155 / 0.65); text-shadow: 0 0 48px oklch(76% 0.17 155 / 0.2);">
              01
            </div>
            <!-- Live engine badge -->
            <div class="flex items-center gap-1.5 rounded-full px-2.5 py-1 border"
                 style="background: oklch(14% 0.048 155 / 0.8); border-color: oklch(76% 0.17 155 / 0.3);">
              <span class="w-1.5 h-1.5 rounded-full dt-pulse" style="background: oklch(76% 0.17 155);"></span>
              <span class="font-mono text-[9px] uppercase tracking-widest" style="color: oklch(76% 0.17 155);">Live Engine</span>
            </div>
          </div>

          <div class="relative mt-4">
            <h3 class="font-heading font-bold text-2xl text-ink mb-3">
              Smart Matchmaking
            </h3>
            <p class="text-ink-2 text-sm leading-loose max-w-lg">
              The engine <strong class="text-ink font-semibold">balances teams by skill level</strong>,
              <strong class="text-ink font-semibold">rotates players fairly by wait time</strong>,
              and enforces <strong class="text-ink font-semibold">partnership caps</strong> so the same two people aren't always paired together.
              Every match feels fresh.
            </p>
          </div>
        </div>

        <!-- Features 02 + 03 — stacked right -->
        <div class="flex flex-col gap-4">
          <div class="feature-card feature-lift-sm rounded-2xl border border-edge bg-overlay p-6 flex-1 transition-colors duration-200 hover:border-edge-hi"
               style="--i: 2">
            <div class="font-heading font-bold text-[3rem] leading-none select-none mb-3"
                 style="color: oklch(76% 0.17 155 / 0.5);">
              02
            </div>
            <h3 class="font-heading font-bold text-lg text-ink mb-2">
              Real-time TV Scoreboard
            </h3>
            <p class="text-ink-3 text-xs leading-relaxed">
              A dedicated display view for the big screen. Every active court,
              every score, every queue position — live, no refresh needed.
            </p>
          </div>

          <div class="feature-card feature-lift-sm rounded-2xl border border-edge bg-overlay p-6 flex-1 transition-colors duration-200 hover:border-edge-hi"
               style="--i: 3">
            <div class="font-heading font-bold text-[3rem] leading-none select-none mb-3"
                 style="color: oklch(76% 0.17 155 / 0.5);">
              03
            </div>
            <h3 class="font-heading font-bold text-lg text-ink mb-2">
              Fair-Play Caps
            </h3>
            <p class="text-ink-3 text-xs leading-relaxed">
              Hard limits on how many times two players can partner up per session.
              Keeps the pool diverse and the games competitive.
            </p>
          </div>
        </div>
      </div>

      <!-- Secondary feature strip -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4">
        {[
          { label: 'Anonymous join',  desc: 'Players scan a QR and join instantly — no app install required.', i: 4 },
          { label: 'Organizer PIN',   desc: 'Secure session management without requiring player accounts.',    i: 5 },
          { label: 'Session Wrapped', desc: 'End-of-session awards celebrate milestones for every player.',   i: 6 },
        ].map(f => (
          <div class="feature-card rounded-xl border border-edge-dim bg-surface/50 px-5 py-4 transition-colors duration-200 hover:border-edge hover:bg-raised/40"
               style={`--i: ${f.i}`}>
            <h4 class="font-heading font-bold text-sm text-ink-2 mb-1.5">{f.label}</h4>
            <p class="text-[11px] text-ink-4 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       HOW IT FLOWS — three-step visual
  ══════════════════════════════════════════════════════════════════ -->
  <section id="how-it-works" data-reveal-section class="px-6 py-20 border-t border-edge-dim">
    <div class="mx-auto max-w-6xl">

      <div class="feature-card mb-12" style="--i: 0">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent mb-3">How it works</p>
        <h2 class="font-heading font-bold text-ink"
            style="font-size: clamp(1.75rem, 3.5vw, 2.5rem);">
          From scan to court in seconds.
        </h2>
      </div>

      <ol class="grid grid-cols-1 sm:grid-cols-3 gap-4">

        <!-- Step 1: Players scan & join — QR code illustration -->
        <li class="feature-card step-card feature-lift-sm relative flex flex-col rounded-2xl border border-edge-dim overflow-hidden transition-colors duration-200 hover:border-edge"
            style="--i: 1; background: oklch(14% 0.065 155 / 0.1)">

          <!-- QR code visual -->
          <div class="relative flex items-center justify-center overflow-hidden"
               style="height: 152px; background: oklch(9% 0.015 245);">
            <div class="relative" style="width: 82px; height: 82px;">
              <!-- Corner scan brackets -->
              <div aria-hidden="true" class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2" style="border-color: oklch(76% 0.17 155 / 0.9)"></div>
              <div aria-hidden="true" class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2" style="border-color: oklch(76% 0.17 155 / 0.9)"></div>
              <div aria-hidden="true" class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2" style="border-color: oklch(76% 0.17 155 / 0.9)"></div>
              <div aria-hidden="true" class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2" style="border-color: oklch(76% 0.17 155 / 0.9)"></div>
              <!-- QR code area (with scan line) -->
              <div class="absolute overflow-hidden" style="inset: 7px;">
                <svg aria-hidden="true" viewBox="0 0 84 84" width="68" height="68" xmlns="http://www.w3.org/2000/svg" style="display:block">
                  <rect x="0"  y="0"  width="28" height="28" fill="oklch(76% 0.17 155)"/><rect x="4"  y="4"  width="20" height="20" fill="oklch(9% 0.015 245)"/><rect x="8"  y="8"  width="12" height="12" fill="oklch(76% 0.17 155)"/>
                  <rect x="56" y="0"  width="28" height="28" fill="oklch(76% 0.17 155)"/><rect x="60" y="4"  width="20" height="20" fill="oklch(9% 0.015 245)"/><rect x="64" y="8"  width="12" height="12" fill="oklch(76% 0.17 155)"/>
                  <rect x="0"  y="56" width="28" height="28" fill="oklch(76% 0.17 155)"/><rect x="4"  y="60" width="20" height="20" fill="oklch(9% 0.015 245)"/><rect x="8"  y="64" width="12" height="12" fill="oklch(76% 0.17 155)"/>
                  <rect x="32" y="24" width="4" height="4" fill="oklch(76% 0.17 155 / 0.8)"/><rect x="40" y="24" width="4" height="4" fill="oklch(76% 0.17 155 / 0.8)"/><rect x="48" y="24" width="4" height="4" fill="oklch(76% 0.17 155 / 0.8)"/>
                  <rect x="24" y="32" width="4" height="4" fill="oklch(76% 0.17 155 / 0.8)"/><rect x="24" y="40" width="4" height="4" fill="oklch(76% 0.17 155 / 0.8)"/><rect x="24" y="48" width="4" height="4" fill="oklch(76% 0.17 155 / 0.8)"/>
                  <rect x="32" y="0"  width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="44" y="0"  width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="52" y="0"  width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/>
                  <rect x="32" y="8"  width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="52" y="8"  width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="44" y="12" width="8" height="4" fill="oklch(76% 0.17 155 / 0.75)"/>
                  <rect x="36" y="16" width="8" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="36" y="20" width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="48" y="20" width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/>
                  <rect x="0"  y="32" width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="8"  y="32" width="8" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="4"  y="36" width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/>
                  <rect x="16" y="36" width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="0"  y="40" width="8" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="4"  y="44" width="8" height="4" fill="oklch(76% 0.17 155 / 0.75)"/>
                  <rect x="16" y="44" width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="0"  y="48" width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="8"  y="48" width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/>
                  <rect x="16" y="48" width="8" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="4"  y="52" width="8" height="4" fill="oklch(76% 0.17 155 / 0.75)"/><rect x="20" y="52" width="4" height="4" fill="oklch(76% 0.17 155 / 0.75)"/>
                  <rect x="28" y="28" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="44" y="28" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="52" y="28" width="12" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="68" y="28" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="32" y="32" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="40" y="32" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="56" y="32" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="68" y="32" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="76" y="32" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="28" y="36" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="40" y="36" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="52" y="36" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="64" y="36" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="72" y="36" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="36" y="40" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="48" y="40" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="60" y="40" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="76" y="40" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="28" y="44" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="40" y="44" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="56" y="44" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="64" y="44" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="72" y="44" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="32" y="48" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="40" y="48" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="52" y="48" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="64" y="48" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="28" y="52" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="36" y="52" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="48" y="52" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="60" y="52" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="72" y="52" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="32" y="56" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="40" y="56" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="52" y="56" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="60" y="56" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="68" y="56" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="28" y="60" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="40" y="60" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="48" y="60" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="60" y="60" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="72" y="60" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="32" y="64" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="44" y="64" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="52" y="64" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="64" y="64" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="76" y="64" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="28" y="68" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="36" y="68" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="52" y="68" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="64" y="68" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="72" y="68" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="32" y="72" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="44" y="72" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="56" y="72" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="68" y="72" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="76" y="72" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="28" y="76" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="40" y="76" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="52" y="76" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="64" y="76" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="76" y="76" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                  <rect x="28" y="80" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="36" y="80" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="48" y="80" width="4" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="56" y="80" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/><rect x="68" y="80" width="8" height="4" fill="oklch(76% 0.17 155 / 0.7)"/>
                </svg>
                <div aria-hidden="true" class="qr-scanline absolute inset-x-0 h-px pointer-events-none"
                     style="background: linear-gradient(90deg, transparent, oklch(76% 0.17 155 / 0.9) 30%, oklch(76% 0.17 155) 50%, oklch(76% 0.17 155 / 0.9) 70%, transparent); box-shadow: 0 0 6px oklch(76% 0.17 155 / 0.6);"></div>
              </div>
            </div>
            <div class="absolute bottom-2.5 inset-x-0 text-center">
              <span class="font-mono text-[8px] uppercase tracking-widest" style="color: oklch(76% 0.17 155 / 0.5)">Scan to join</span>
            </div>
          </div>

          <div class="flex flex-col gap-3 px-5 pt-4 pb-5">
            <p class="font-mono text-[9px] uppercase tracking-widest" style="color: oklch(76% 0.17 155 / 0.5)">Step 1 / 3</p>
            <div class="w-10 h-10 rounded-full flex items-center justify-center bg-accent shrink-0"
                 style="box-shadow: 0 0 0 4px oklch(76% 0.17 155 / 0.18), 0 0 0 8px oklch(76% 0.17 155 / 0.07);">
              <span class="font-heading font-bold text-sm" style="color: var(--color-base)">1</span>
            </div>
            <div>
              <h3 class="font-heading font-bold text-base text-ink mb-2">Players scan & join</h3>
              <p class="text-sm text-ink-3 leading-relaxed">A QR code at the venue. Tap, enter a name, you're in the queue. No app, no account.</p>
            </div>
          </div>
        </li>


        <!-- Step 2: Organizer generates matches — queue + generate mockup -->
        <li class="feature-card step-card feature-lift-sm relative flex flex-col rounded-2xl border border-edge-dim overflow-hidden transition-colors duration-200 hover:border-edge"
            style="--i: 2; background: oklch(14% 0.065 155 / 0.22)">

          <div class="relative px-4 pt-3 overflow-hidden"
               style="height: 152px; background: oklch(9% 0.015 245);">
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[8px] uppercase tracking-widest" style="color: oklch(76% 0.17 155 / 0.65)">Queue · 6 waiting</span>
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent dt-pulse"></span>
            </div>
            <div class="flex flex-col gap-1">
              {[
                { name: 'Alex T.',  level: 'S3', wait: '14m' },
                { name: 'Maria L.', level: 'S2', wait: '11m' },
