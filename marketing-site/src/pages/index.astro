<style>
  /* dt-pulse is defined in global.css — available here */
  /* Smooth anchor-link scrolling already set on <html> via scroll-smooth */
</style>

<script>
  // Generic scroll-reveal: any section with data-reveal-section gets its .feature-card
  // children animated in with a stagger when the section enters the viewport.
  document.querySelectorAll('[data-reveal-section]').forEach(section => {
    const cards = Array.from(section.querySelectorAll('.feature-card'));
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          cards.forEach(card => card.classList.add('in-view'));
          io.disconnect();
          // Reset stagger delays after all animations finish so hover is instant
          const maxMs = 550 + cards.length * 90 + 50;
          setTimeout(() => {
            cards.forEach(card => card.style.setProperty('--i', '0'));
          }, maxMs);
        }
      });
    }, { threshold: 0.08 });
    io.observe(section);
  });
</script>
