#!/usr/bin/env sh
set -e

# ── Design-token sync ────────────────────────────────────────────────────────
# If globals.css, layout.tsx, or organizer/layout.tsx are staged, re-extract
# the manifest and patch APP_MANIFEST.md §4.1 token tables automatically.
# The patched file is re-staged so it travels with the commit.
# Failure aborts the commit (set -e propagates).
DESIGN_STAGED=$(git diff --cached --name-only | grep -E \
  'src/app/globals\.css|src/app/layout\.tsx|src/app/organizer/layout\.tsx' || true)

if [ -n "$DESIGN_STAGED" ]; then
  echo "[pre-commit] design token source changed — re-syncing APP_MANIFEST…"
  (cd digital-twin && npx tsx scripts/extract.ts && npx tsx scripts/sync-design-tokens.ts) \
    || { echo "[pre-commit] ✗ token sync failed — commit aborted"; exit 1; }
  git add APP_MANIFEST.md
fi

# ── Living-document size caps ────────────────────────────────────────────────
# MEMORY.md is loaded into context every session. It grew 12 KB -> 678 KB in four
# months, and the last commit that DELETED anything from it was 2026-05-19 — the
# prune habit stopped exactly where the growth curve started. Past ~200 KB the
# mandated read set no longer fits the context window, which does not fail loudly:
# it silently truncates, and MEMORY.md is newest-first, so what gets dropped is the
# current-state reference at the END — the part that actually matters.
#
# This cap is the forcing function. When it fires, the fix is to MOVE closed
# entries to docs/archive/, not to raise the number.
#   Escape hatch (use it only to land the cleanup itself): git commit --no-verify
#
# The two documents are capped on DIFFERENT things, because they are read in
# different ways and only one of them is read whole.
#
#   MEMORY.md      — loaded in full every session. Total bytes ARE the cost, so
#                    the cap is on total bytes and it is hard.
#   APP_MANIFEST.md — never read whole (CLAUDE.md forbids it); it is opened one
#                    indexed section at a time. Total bytes are not the cost —
#                    the largest SINGLE SECTION is, because that is the block a
#                    reader is told to open, and an oversized one truncates the
#                    context silently. So the manifest is checked by section, by
#                    `gen-doc-index.mjs --check`, and the remedy is a `####`
#                    sub-heading, not a deletion. A 346 KB file whose median
#                    section is 1.6 KB is FINE; nothing needs to be left out.
MEMORY_CAP=40000

if git diff --cached --name-only | grep -qx 'MEMORY.md'; then
  SIZE=$(git show :MEMORY.md | wc -c | tr -d ' ')
  if [ "$SIZE" -gt "$MEMORY_CAP" ]; then
    echo "[pre-commit] ✗ MEMORY.md is ${SIZE} bytes, cap is ${MEMORY_CAP}."
    echo "             Move ✅ SHIPPED / CLOSED entries to docs/archive/ — do not raise the cap."
    echo "             Override for the cleanup commit itself: git commit --no-verify"
    exit 1
  fi
  echo "[pre-commit] ✓ MEMORY.md ${SIZE}/${MEMORY_CAP} bytes"
fi

if git diff --cached --name-only | grep -qx 'APP_MANIFEST.md'; then
  # Measure the STAGED blob, not the working tree — the commit is what ships.
  STAGED_MANIFEST=$(mktemp)
  git show :APP_MANIFEST.md > "$STAGED_MANIFEST"
  node scripts/gen-doc-index.mjs --check "$STAGED_MANIFEST" || {
    rm -f "$STAGED_MANIFEST"
    echo "             Override for the split commit itself: git commit --no-verify"
    exit 1
  }
  rm -f "$STAGED_MANIFEST"
fi

# ── Lint-staged (Prettier, ESLint) ───────────────────────────────────────────
npx lint-staged
