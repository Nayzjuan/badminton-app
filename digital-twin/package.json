{
  "name": "badminton-app-digital-twin",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "extract": "tsx scripts/extract.ts",
    "watch:extract": "tsx scripts/watch.ts",
    "dev:full": "concurrently \"npm run watch:extract\" \"npm run dev\""
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.7.0",
    "d3": "^7.9.0",
    "pagefind": "^1.3.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
