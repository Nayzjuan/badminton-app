    "astro": "^5.7.0",
    "d3": "^7.9.0",
    "pagefind": "^1.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
