---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import manifest from '../data/manifest.json';

interface TableColumnDrift {
  table: string;
  dbOnly: string[];
  codeOnly: string[];
}

interface SchemaDrift {
  capturedAt: string;
  ok: boolean;
  tableColumnDrift: TableColumnDrift[];
  functions: { dbOnly: string[]; dbOnlyExpected: string[]; codeOnly: string[] };
  views: { dbOnly: string[]; codeOnly: string[] };
  tables: { dbOnly: string[]; codeOnly: string[] };
}

// Cast through unknown so a null manifest value is representable & must be guarded.
const drift = manifest.schemaDrift as unknown as SchemaDrift | null;

// ── Color tokens (oklch, mirroring glossary.astro severityMeta) ───────────
const tone = {
  green: { // in-sync (hue 155)
    text:   'oklch(72% 0.16 155)',
    bg:     'oklch(18% 0.030 155)',
    border: 'oklch(42% 0.14 155 / 0.45)',
  },
  red: {   // real drift (hue 22)
    text:   'oklch(70% 0.20 22)',
    bg:     'oklch(18% 0.030 22)',
    border: 'oklch(42% 0.18 22 / 0.45)',
  },
  amber: { // warning banner (hue 70)
    text:   'oklch(80% 0.16 70)',
    bg:     'oklch(20% 0.035 70)',
    border: 'oklch(52% 0.14 70 / 0.45)',
  },
  blue: {  // info / methodology (hue 245)
    text:   'oklch(62% 0.08 245)',
    bg:     'oklch(17% 0.025 245)',
    border: 'oklch(38% 0.05 245 / 0.5)',
  },
};

// ── Build-time data shaping (only when drift snapshot exists) ─────────────
const ok = drift?.ok ?? false;

const tablesCodeOnly = drift?.tables.codeOnly ?? [];
const tablesDbOnly   = drift?.tables.dbOnly ?? [];
const columnDrift    = drift?.tableColumnDrift ?? [];
const fnDbOnly       = drift?.functions.dbOnly ?? [];
const fnCodeOnly     = drift?.functions.codeOnly ?? [];
const fnDbExpected   = drift?.functions.dbOnlyExpected ?? [];
const viewsDbOnly    = drift?.views.dbOnly ?? [];
const viewsCodeOnly  = drift?.views.codeOnly ?? [];

const hasTableDrift  = tablesCodeOnly.length > 0 || tablesDbOnly.length > 0;
const hasColumnDrift = columnDrift.length > 0;
const hasFnDrift     = fnDbOnly.length > 0 || fnCodeOnly.length > 0;
const hasViewDrift   = viewsDbOnly.length > 0 || viewsCodeOnly.length > 0;

// Total count of REAL drift findings (expected DB-only is excluded by design).
const realDriftCount =
  tablesCodeOnly.length + tablesDbOnly.length +
  columnDrift.reduce((n, c) => n + c.dbOnly.length + c.codeOnly.length, 0) +
  fnDbOnly.length + fnCodeOnly.length +
  viewsDbOnly.length + viewsCodeOnly.length;
---

<BaseLayout
  title="Schema Drift"
  description="Live comparison of the TypeScript database types against a Supabase introspection snapshot — surfacing any divergence between code and the real schema."
>
  <PageHeader
    title="Schema Drift"
    subtitle="Compares the TypeScript types in src/types/database.ts against a live Supabase introspection snapshot. Code-only = declared in types but missing from the DB; DB-only = exists in the DB but absent from types."
    phaseStatus="live"
  />

  {drift === null ? (
    <!-- ── Null-guard fallback ──────────────────────────────────────────── -->
    <div class="px-8 py-8">
      <div class="bg-surface border border-edge-dim rounded-xl p-8 text-center">
        <p class="text-sm text-ink-3 font-mono">No schema-drift snapshot available.</p>
        <p class="text-xs text-ink-4 mt-2 max-w-md mx-auto leading-relaxed">
          Run the introspection capture to populate
          <code class="font-mono text-xs text-ink-3 bg-base px-1.5 py-0.5 rounded border border-edge-dim">manifest.schemaDrift</code>,
          then rebuild this page.
        </p>
      </div>
    </div>
  ) : (
    <div class="px-8 py-8 space-y-8" data-pagefind-body>

      <!-- ── Status banner ─────────────────────────────────────────────── -->
      {ok ? (
        <div
          class="rounded-xl p-6 flex items-start gap-4"
          style={`background:${tone.green.bg};border:1px solid ${tone.green.border}`}
        >
          <span class="text-2xl leading-none mt-0.5" style={`color:${tone.green.text}`}>✓</span>
          <div>
            <h2 class="text-lg font-semibold font-heading tracking-tight" style={`color:${tone.green.text}`}>
              Schema in sync
            </h2>
            <p class="text-sm text-ink-3 mt-1 leading-relaxed">
              The TypeScript types and the live database agree on every table, column, view, and RPC.
              Snapshot captured <code class="font-mono text-xs text-ink-3 bg-base px-1.5 py-0.5 rounded border border-edge-dim">{drift.capturedAt}</code>.
            </p>
          </div>
        </div>
      ) : (
        <div
          class="rounded-xl p-6 flex items-start gap-4"
          style={`background:${tone.amber.bg};border:1px solid ${tone.amber.border}`}
        >
          <span class="text-2xl leading-none mt-0.5" style={`color:${tone.amber.text}`}>⚠</span>
          <div>
            <h2 class="text-lg font-semibold font-heading tracking-tight" style={`color:${tone.amber.text}`}>
              Drift detected
            </h2>
            <p class="text-sm text-ink-3 mt-1 leading-relaxed">
              <span class="font-mono" style={`color:${tone.red.text}`}>{realDriftCount}</span>
              divergence{realDriftCount === 1 ? '' : 's'} between
              <code class="font-mono text-xs text-ink-3 bg-base px-1.5 py-0.5 rounded border border-edge-dim">src/types/database.ts</code>
              and the live schema. Review the sections below.
              Snapshot captured <code class="font-mono text-xs text-ink-3 bg-base px-1.5 py-0.5 rounded border border-edge-dim">{drift.capturedAt}</code>.
            </p>
          </div>
        </div>
      )}

      <!-- ── Methodology note ──────────────────────────────────────────── -->
      <div
        class="rounded-xl p-5"
        style={`background:${tone.blue.bg};border:1px solid ${tone.blue.border}`}
      >
        <h2 class="text-sm font-semibold font-heading tracking-tight mb-2" style={`color:${tone.blue.text}`}>
          How this is computed
        </h2>
        <p class="text-xs text-ink-3 leading-relaxed max-w-3xl">
          This page diffs the hand-written TypeScript types in
          <code class="font-mono text-xs text-ink-3 bg-base px-1.5 py-0.5 rounded border border-edge-dim">src/types/database.ts</code>
          against a live Supabase introspection snapshot captured
          <code class="font-mono text-xs text-ink-3 bg-base px-1.5 py-0.5 rounded border border-edge-dim">{drift.capturedAt}</code>.
        </p>
        <div class="flex flex-wrap gap-4 mt-3 text-xs">
          <div class="flex items-start gap-2">
            <span class="font-mono font-bold shrink-0" style={`color:${tone.red.text}`}>Code-only</span>
            <span class="text-ink-4">declared in the types but missing from the DB.</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="font-mono font-bold shrink-0" style={`color:${tone.red.text}`}>DB-only</span>
            <span class="text-ink-4">exists in the DB but absent from the types.</span>
          </div>
        </div>
      </div>

      <!-- ── Tables ────────────────────────────────────────────────────── -->
      <section>
        <h2 class="text-lg font-semibold text-ink font-heading tracking-tight mb-3">Tables</h2>
        {hasTableDrift ? (
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="bg-surface border border-edge-dim rounded-xl p-5">
              <p class="text-[10px] font-mono font-bold uppercase tracking-wide mb-2" style={`color:${tone.red.text}`}>
                DB-only · {tablesDbOnly.length}
              </p>
              {tablesDbOnly.length > 0 ? (
                <ul class="flex flex-wrap gap-1.5">
                  {tablesDbOnly.map(t => (
                    <li
                      class="font-mono text-xs px-2 py-0.5 rounded"
                      style={`color:${tone.red.text};background:${tone.red.bg};border:1px solid ${tone.red.border}`}
                    >{t}</li>
                  ))}
                </ul>
              ) : (
                <p class="text-xs text-ink-4 font-mono">none</p>
              )}
            </div>
            <div class="bg-surface border border-edge-dim rounded-xl p-5">
              <p class="text-[10px] font-mono font-bold uppercase tracking-wide mb-2" style={`color:${tone.red.text}`}>
                Code-only · {tablesCodeOnly.length}
              </p>
              {tablesCodeOnly.length > 0 ? (
                <ul class="flex flex-wrap gap-1.5">
                  {tablesCodeOnly.map(t => (
                    <li
                      class="font-mono text-xs px-2 py-0.5 rounded"
                      style={`color:${tone.red.text};background:${tone.red.bg};border:1px solid ${tone.red.border}`}
                    >{t}</li>
                  ))}
                </ul>
              ) : (
                <p class="text-xs text-ink-4 font-mono">none</p>
              )}
            </div>
          </div>
        ) : (
          <div class="bg-surface border border-edge-dim rounded-xl p-5 flex items-center gap-2">
            <span class="font-mono text-xs" style={`color:${tone.green.text}`}>✓ in sync</span>
            <span class="text-xs text-ink-4">— no table-level drift.</span>
          </div>
        )}
      </section>

      <!-- ── Columns ───────────────────────────────────────────────────── -->
      <section>
        <h2 class="text-lg font-semibold text-ink font-heading tracking-tight mb-3">Columns</h2>
        {hasColumnDrift ? (
          <div class="space-y-3">
            {columnDrift.map(c => (
              <div class="bg-surface border border-edge-dim rounded-xl p-5">
                <p class="font-mono text-sm text-accent mb-3">{c.table}</p>
                <div class="grid gap-3 sm:grid-cols-2">
                  <div>
                    <p class="text-[10px] font-mono font-bold uppercase tracking-wide mb-2" style={`color:${tone.red.text}`}>
                      DB-only · {c.dbOnly.length}
                    </p>
                    {c.dbOnly.length > 0 ? (
                      <ul class="flex flex-wrap gap-1.5">
                        {c.dbOnly.map(col => (
                          <li
                            class="font-mono text-xs px-2 py-0.5 rounded"
                            style={`color:${tone.red.text};background:${tone.red.bg};border:1px solid ${tone.red.border}`}
                          >{col}</li>
                        ))}
                      </ul>
                    ) : (
                      <p class="text-xs text-ink-4 font-mono">none</p>
                    )}
                  </div>
                  <div>
                    <p class="text-[10px] font-mono font-bold uppercase tracking-wide mb-2" style={`color:${tone.red.text}`}>
                      Code-only · {c.codeOnly.length}
                    </p>
                    {c.codeOnly.length > 0 ? (
                      <ul class="flex flex-wrap gap-1.5">
                        {c.codeOnly.map(col => (
                          <li
                            class="font-mono text-xs px-2 py-0.5 rounded"
                            style={`color:${tone.red.text};background:${tone.red.bg};border:1px solid ${tone.red.border}`}
                          >{col}</li>
                        ))}
                      </ul>
                    ) : (
                      <p class="text-xs text-ink-4 font-mono">none</p>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="bg-surface border border-edge-dim rounded-xl p-5 flex items-center gap-2">
            <span class="font-mono text-xs" style={`color:${tone.green.text}`}>✓ in sync</span>
            <span class="text-xs text-ink-4">— every typed column matches the DB.</span>
          </div>
        )}
      </section>

      <!-- ── Functions / RPCs ──────────────────────────────────────────── -->
      <section>
        <h2 class="text-lg font-semibold text-ink font-heading tracking-tight mb-3">Functions / RPCs</h2>
        {hasFnDrift ? (
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="bg-surface border border-edge-dim rounded-xl p-5">
              <p class="text-[10px] font-mono font-bold uppercase tracking-wide mb-2" style={`color:${tone.red.text}`}>
                DB-only (real drift) · {fnDbOnly.length}
              </p>
              {fnDbOnly.length > 0 ? (
                <ul class="flex flex-wrap gap-1.5">
                  {fnDbOnly.map(f => (
                    <li
                      class="font-mono text-xs px-2 py-0.5 rounded"
                      style={`color:${tone.red.text};background:${tone.red.bg};border:1px solid ${tone.red.border}`}
                    >{f}</li>
                  ))}
                </ul>
              ) : (
                <p class="text-xs text-ink-4 font-mono">none</p>
              )}
            </div>
            <div class="bg-surface border border-edge-dim rounded-xl p-5">
              <p class="text-[10px] font-mono font-bold uppercase tracking-wide mb-2" style={`color:${tone.red.text}`}>
                Code-only · {fnCodeOnly.length}
              </p>
              {fnCodeOnly.length > 0 ? (
                <ul class="flex flex-wrap gap-1.5">
                  {fnCodeOnly.map(f => (
                    <li
                      class="font-mono text-xs px-2 py-0.5 rounded"
                      style={`color:${tone.red.text};background:${tone.red.bg};border:1px solid ${tone.red.border}`}
                    >{f}</li>
                  ))}
                </ul>
              ) : (
                <p class="text-xs text-ink-4 font-mono">none</p>
              )}
            </div>
          </div>
        ) : (
          <div class="bg-surface border border-edge-dim rounded-xl p-5 flex items-center gap-2">
            <span class="font-mono text-xs" style={`color:${tone.green.text}`}>✓ in sync</span>
            <span class="text-xs text-ink-4">— no real RPC drift.</span>
          </div>
        )}

        <!-- Expected DB-only (intentional, NOT drift) -->
        {fnDbExpected.length > 0 && (
          <details class="mt-3 bg-base border border-edge-dim rounded-xl p-5 group">
            <summary class="cursor-pointer list-none flex items-center gap-2 select-none">
              <span class="text-ink-4 text-xs transition-transform group-open:rotate-90">▶</span>
              <span class="text-sm font-medium text-ink-3 font-heading">
                Expected DB-only
                <span class="text-ink-4 font-normal font-mono text-xs ml-1">· {fnDbExpected.length}</span>
              </span>
            </summary>
            <p class="text-xs text-ink-4 leading-relaxed mt-3 max-w-3xl">
              Triggers, <code class="font-mono text-xs text-ink-4 bg-surface px-1.5 py-0.5 rounded border border-edge-dim">SECURITY DEFINER</code> helpers,
              and internal <code class="font-mono text-xs text-ink-4 bg-surface px-1.5 py-0.5 rounded border border-edge-dim">_</code>-prefixed helpers.
              These exist in the DB on purpose and are intentionally <strong class="text-ink-3 font-medium">not</strong> exposed as PostgREST RPCs,
              so they never appear in the generated types. This is by design — not drift.
            </p>
            <ul class="flex flex-wrap gap-1.5 mt-3">
              {fnDbExpected.map(f => (
                <li class="font-mono text-xs text-ink-4 bg-surface px-2 py-0.5 rounded border border-edge-dim">{f}</li>
              ))}
            </ul>
          </details>
        )}
      </section>

      <!-- ── Views ─────────────────────────────────────────────────────── -->
      <section>
        <h2 class="text-lg font-semibold text-ink font-heading tracking-tight mb-3">Views</h2>
        {hasViewDrift ? (
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="bg-surface border border-edge-dim rounded-xl p-5">
              <p class="text-[10px] font-mono font-bold uppercase tracking-wide mb-2" style={`color:${tone.red.text}`}>
                DB-only · {viewsDbOnly.length}
              </p>
              {viewsDbOnly.length > 0 ? (
                <ul class="flex flex-wrap gap-1.5">
                  {viewsDbOnly.map(v => (
                    <li
                      class="font-mono text-xs px-2 py-0.5 rounded"
                      style={`color:${tone.red.text};background:${tone.red.bg};border:1px solid ${tone.red.border}`}
                    >{v}</li>
                  ))}
                </ul>
              ) : (
                <p class="text-xs text-ink-4 font-mono">none</p>
              )}
            </div>
            <div class="bg-surface border border-edge-dim rounded-xl p-5">
              <p class="text-[10px] font-mono font-bold uppercase tracking-wide mb-2" style={`color:${tone.red.text}`}>
                Code-only · {viewsCodeOnly.length}
              </p>
              {viewsCodeOnly.length > 0 ? (
                <ul class="flex flex-wrap gap-1.5">
                  {viewsCodeOnly.map(v => (
                    <li
                      class="font-mono text-xs px-2 py-0.5 rounded"
                      style={`color:${tone.red.text};background:${tone.red.bg};border:1px solid ${tone.red.border}`}
                    >{v}</li>
                  ))}
                </ul>
              ) : (
                <p class="text-xs text-ink-4 font-mono">none</p>
              )}
            </div>
          </div>
        ) : (
          <div class="bg-surface border border-edge-dim rounded-xl p-5 flex items-center gap-2">
            <span class="font-mono text-xs" style={`color:${tone.green.text}`}>✓ in sync</span>
            <span class="text-xs text-ink-4">— no view-level drift.</span>
          </div>
        )}
      </section>

    </div>
  )}
</BaseLayout>
