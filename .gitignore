# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── E2E Testing ───────────────────────────────────────────────
.env.test
.playwright/
playwright-report/
test-results/

# ── Backups (contain real data — keep local only) ─────────────
backups/*.sql
backups/backup_*/
backups/__pycache__/
# Database snapshots dumped to the repo root (real player data — local only)
/backup-*.json

# ── Local tool artifacts ─────────────────────────────────────
# Claude Code agent worktrees (ephemeral)
.claude/worktrees/
# Serena LSP/code-intel config (local; each dev runs their own init)
.serena/
# Supabase CLI working state
supabase/.branches/
supabase/.temp/
# Production snapshots from scripts/prod-snapshot.ts — full table dumps of REAL
# member data (names, emails, PINs). Never commit these.
.prod-baseline/
# Engine replay fixtures from scripts/replay-sessions.ts — real session rosters
# (member names + skill levels) and the saved metric runs derived from them.
.replay-cache/
